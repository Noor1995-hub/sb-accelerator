filters:
  and:
    - file.inFolder("30-projects")
    - type == "decision"
formulas:
  open: link(file.path, "→")
properties:
  formula.open:
    displayName: " "
  note.summary:
    displayName: Decision
  note.project:
    displayName: Project
  note.date:
    displayName: Date
  note.status:
    displayName: Status
  note.reviewed:
    displayName: ✓ Reviewed
  note.supersedes:
    displayName: Supersedes
views:
  - type: table
    name: Needs review
    filters:
      and:
        - reviewed != true
    order:
      - formula.open
      - summary
      - project
      - date
      - reviewed
      - status
      - supersedes
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - formula.open
      - summary
      - project
      - date
    sort:
      - property: date
        direction: DESC
  - type: table
    name: All
    order:
      - formula.open
      - summary
      - project
      - date
      - status
      - reviewed
      - supersedes
    sort:
      - property: date
        direction: DESC
