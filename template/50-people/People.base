filters:
  and:
    - file.inFolder("50-people")
    - file.ext == "md"
    - '!note["person-name"].isEmpty()'
formulas:
  open: link(file.path, "→")
properties:
  formula.open:
    displayName: " "
  note.person-name:
    displayName: Name
  note.relationship:
    displayName: Relationship
  note.company:
    displayName: Company
  note.role:
    displayName: Role
  note.projects:
    displayName: Projects
  note.meetings-30d:
    displayName: Meetings (30d)
  note.last-updated:
    displayName: Updated
views:
  - type: table
    name: All
    order:
      - formula.open
      - person-name
      - relationship
      - company
      - role
      - projects
      - meetings-30d
      - last-updated
    sort:
      - property: last-updated
        direction: DESC
  - type: table
    name: Uncurated
    filters:
      and:
        - relationship.isEmpty()
    order:
      - formula.open
      - person-name
      - company
      - role
      - meetings-30d
    sort:
      - property: meetings-30d
        direction: DESC
