filters:
  and:
    - file.name == "dossier"
    - type == "entity"
formulas:
  open: link(file.path, "→")
  group: if(parent, if(file("40-entities/" + parent + "/dossier.md"), file("40-entities/" + parent + "/dossier.md").properties["entity-name"], parent), note["entity-name"])
  part-of: if(parent, link("40-entities/" + parent + "/dossier.md", if(file("40-entities/" + parent + "/dossier.md"), file("40-entities/" + parent + "/dossier.md").properties["entity-name"], parent)), "")
  team-order: if(parent, 1, 0)
  name: if(parent, "↳ " + note["entity-name"], note["entity-name"])
  owner-name: if(owner, if(file("50-people/" + owner + ".md"), file("50-people/" + owner + ".md").properties["person-name"], owner), "")
  kind: if(note["entity-type"] == "business-unit", "Business unit", if(note["entity-type"], note["entity-type"].title(), ""))
  state: if(status, status.title(), "")
properties:
  formula.open:
    displayName: " "
  formula.group:
    displayName: " "
  formula.part-of:
    displayName: Part of
  note.entity-name:
    displayName: Entity
  formula.name:
    displayName: Entity
  formula.kind:
    displayName: Type
  formula.state:
    displayName: Status
  note.industry:
    displayName: Industry
  formula.owner-name:
    displayName: Owner
  note.last-updated:
    displayName: Updated
views:
  - type: table
    name: All
    order:
      - formula.open
      - formula.name
      - formula.part-of
      - formula.kind
      - formula.state
      - industry
      - formula.owner-name
      - last-updated
    sort:
      - property: formula.group
        direction: ASC
      - property: formula.team-order
        direction: ASC
      - property: entity-name
        direction: ASC
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - formula.open
      - formula.name
      - formula.part-of
      - formula.kind
      - industry
      - formula.owner-name
      - last-updated
    sort:
      - property: formula.group
        direction: ASC
      - property: formula.team-order
        direction: ASC
      - property: entity-name
        direction: ASC
  - type: table
    name: Prospects
    filters:
      and:
        - status == "prospect"
    order:
      - formula.open
      - entity-name
      - industry
      - last-updated
    sort:
      - property: last-updated
        direction: DESC
