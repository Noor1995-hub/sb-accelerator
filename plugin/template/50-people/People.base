filters:
  and:
    - file.inFolder("50-people")
    - file.ext == "md"
    - '!note["person-name"].isEmpty()'
formulas:
  open: link(file.path, "→")
  # Project names, not slugs (#240); the projects list itself stays
  # editable on the person's note.
  project-names: if(projects, projects.map(link("30-projects/" + value + "/index.md", if(file("30-projects/" + value + "/index.md"), file("30-projects/" + value + "/index.md").properties["project-name"], value))), "")
properties:
  formula.open:
    displayName: " "
  note.person-name:
    displayName: Name
  note.relationship:
    displayName: Relationship
  note.company:
    displayName: Company
  note.role:
    displayName: Role
  formula.project-names:
    displayName: Projects
  note.meetings-30d:
    displayName: Meetings (30 days)
  note.last-met:
    displayName: Last met
views:
  - type: table
    name: All
    order:
      - formula.open
      - person-name
      - relationship
      - company
      - role
      - last-met
      - meetings-30d
      - formula.project-names
    sort:
      - property: person-name
        direction: ASC
    columnSize:
      formula.project-names: 260
  - type: table
    name: Recently met
    filters:
      and:
        - '!note["last-met"].isEmpty()'
    order:
      - formula.open
      - person-name
      - last-met
      - relationship
      - company
      - role
      - meetings-30d
      - formula.project-names
    sort:
      - property: last-met
        direction: DESC
    columnSize:
      formula.project-names: 260
  - type: table
    name: Uncurated
    filters:
      and:
        - relationship.isEmpty()
    order:
      - formula.open
      - person-name
      - company
      - role
      - meetings-30d
    sort:
      - property: meetings-30d
        direction: DESC
  - type: table
    name: Direct reports
    filters:
      and:
        - 'relationship == "direct-report"'
    order:
      - formula.open
      - person-name
      - role
      - meetings-30d
      - last-met
    sort:
      - property: person-name
        direction: ASC
