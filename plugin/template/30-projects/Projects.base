filters:
  and:
    - file.inFolder("30-projects")
    - file.name == "index"
formulas:
  open: link(file.path, "→")
properties:
  formula.open:
    displayName: " "
  note.project-name:
    displayName: Project
  note.status:
    displayName: Status
  note.project-type:
    displayName: Type
  note.entity:
    displayName: Entity
  note.owner:
    displayName: Owner
  note.next-milestone:
    displayName: Next Milestone
  note.next-milestone-date:
    displayName: Due
  note.last-updated:
    displayName: Updated
views:
  - type: table
    name: Active
    groupBy:
      property: note.project-type
      direction: ASC
    filters:
      and:
        - status == "active"
    order:
      - formula.open
      - project-name
      - entity
      - next-milestone
      - next-milestone-date
      - last-updated
      - project-type
    sort:
      - property: last-updated
        direction: DESC
  - type: table
    name: All
    order:
      - formula.open
      - project-name
      - status
      - project-type
      - entity
      - owner
      - last-updated
    sort:
      - property: last-updated
        direction: DESC
