filters:
  and:
    - file.inFolder("30-projects")
    - file.name == "index"
formulas:
  open: link(file.path, "→")
  # Names, not slugs (#240): the entity and owner are looked up from their
  # own notes, so the table shows whatever name the owner gave them; a slug
  # with no note behind it still shows, as itself.
  entity-link: if(entity, link("40-entities/" + entity + "/dossier.md", if(file("40-entities/" + entity + "/dossier.md"), file("40-entities/" + entity + "/dossier.md").properties["entity-name"], entity)), "")
  owner-name: if(owner, if(file("50-people/" + owner + ".md"), file("50-people/" + owner + ".md").properties["person-name"], owner), "")
  kind: if(note["project-type"] == "area-of-responsibility", "Responsibility", if(note["project-type"] == "initiative", "Project", note["project-type"]))
  state: if(status, status.title(), "")
properties:
  formula.open:
    displayName: " "
  note.project-name:
    displayName: Project
  formula.state:
    displayName: Status
  formula.kind:
    displayName: Type
  formula.entity-link:
    displayName: Entity
  formula.owner-name:
    displayName: Owner
  note.next-milestone:
    displayName: Next Milestone
  note.next-milestone-date:
    displayName: Due
  note.last-updated:
    displayName: Updated
  note.meetings-30d:
    displayName: Meetings (30 days)
  note.meetings-7d:
    displayName: Meetings (7 days)
views:
  - type: table
    name: Active
    groupBy:
      property: formula.kind
      direction: ASC
    filters:
      and:
        - status == "active"
    order:
      - formula.open
      - project-name
      - formula.entity-link
      - next-milestone
      - next-milestone-date
      - last-updated
      - meetings-30d
      - meetings-7d
    columnSize:
      note.next-milestone: 210
      note.next-milestone-date: 110
      note.last-updated: 110
      note.meetings-30d: 160
      note.meetings-7d: 150
    sort:
      - property: last-updated
        direction: DESC
  - type: table
    name: All
    order:
      - formula.open
      - project-name
      - formula.state
      - formula.kind
      - formula.entity-link
      - formula.owner-name
      - last-updated
    sort:
      - property: last-updated
        direction: DESC
