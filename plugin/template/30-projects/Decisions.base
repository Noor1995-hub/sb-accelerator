filters:
  and:
    - file.inFolder("30-projects")
    - type == "decision"
formulas:
  open: link(file.path, "→")
  # Names, not codes (#240): the project's name, and the replaced
  # decision's own sentence rather than its file name.
  project-link: if(project, link("30-projects/" + project + "/index.md", if(file("30-projects/" + project + "/index.md"), file("30-projects/" + project + "/index.md").properties["project-name"], project)), "")
  replaces: if(supersedes, link(file(supersedes), file(supersedes).properties["summary"]), "")
  decision-status: if(archived, "Dismissed", if(status == "superseded", "Replaced", if(status == "withdrawn", "Withdrawn", if(status == "active", "Active", status))))
properties:
  formula.open:
    displayName: " "
  formula.decision-status:
    displayName: Status
  note.summary:
    displayName: Decision
  formula.project-link:
    displayName: Project
  note.date:
    displayName: Date
  note.status:
    displayName: Status
  note.reviewed:
    displayName: Keep
  note.archived:
    displayName: Dismiss
  formula.replaces:
    displayName: Replaces
views:
  - type: table
    name: To review
    filters:
      and:
        - reviewed != true
        - archived != true
    order:
      - formula.open
      - date
      - summary
      - formula.project-link
      - reviewed
      - archived
      - formula.decision-status
      - formula.replaces
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.summary: 240
      note.archived: 80
      formula.decision-status: 104
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
        - archived != true
    order:
      - formula.open
      - date
      - summary
      - formula.project-link
    sort:
      - property: date
        direction: DESC
  - type: table
    name: All
    order:
      - formula.open
      - date
      - summary
      - formula.project-link
      - reviewed
      - archived
      - formula.decision-status
      - formula.replaces
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.summary: 240
      note.archived: 80
      formula.decision-status: 104
