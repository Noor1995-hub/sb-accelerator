filters:
  and:
    - file.inFolder("30-projects")
    - type == "decision"
formulas:
  open: link(file.path, "→")
  decision-status: if(status == "superseded", "Replaced", if(status == "withdrawn", "Withdrawn", if(status == "active", "Active", status)))
properties:
  formula.open:
    displayName: " "
  formula.decision-status:
    displayName: Status
  note.summary:
    displayName: Decision
  note.project:
    displayName: Project
  note.date:
    displayName: Date
  note.status:
    displayName: Status
  note.reviewed:
    displayName: Keep
  note.supersedes:
    displayName: Replaces
views:
  - type: table
    name: To review
    filters:
      and:
        - reviewed != true
    order:
      - formula.open
      - date
      - summary
      - project
      - reviewed
      - formula.decision-status
      - supersedes
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.summary: 260
      formula.decision-status: 104
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - formula.open
      - date
      - summary
      - project
    sort:
      - property: date
        direction: DESC
  - type: table
    name: All
    order:
      - formula.open
      - date
      - summary
      - project
      - reviewed
      - formula.decision-status
      - supersedes
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.summary: 260
      formula.decision-status: 104
