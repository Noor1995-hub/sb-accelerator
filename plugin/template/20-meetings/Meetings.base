filters:
  and:
    - file.inFolder("20-meetings")
    - file.ext == "md"
formulas:
  open: link(file.path, "→")
  project-links: projects.map(link("30-projects/" + value + "/index.md", "↗"))
  review-state: if(archived, "Dismissed", if(reviewed || review_status == "confirmed", "Kept", "To review"))
properties:
  formula.open:
    displayName: " "
  formula.project-links:
    displayName: Open project
  formula.review-state:
    displayName: Status
  note.date:
    displayName: Date
  note.type:
    displayName: Type
  note.calendar-subject:
    displayName: Subject
  note.calendar_match:
    displayName: Calendar match
  note.attendees:
    displayName: Attendees
  note.projects:
    displayName: Projects
  note.review_status:
    displayName: Review Status
  note.conflicts-with:
    displayName: "⚠ Duplicate of"
  note.reviewed:
    displayName: Keep
  note.archived:
    displayName: Dismiss
  note.recording-duration:
    displayName: Duration
  note.source:
    displayName: Source
views:
  - type: table
    name: Triage
    filters:
      and:
        - review_status == "needs-review"
        - reviewed != true
        - archived != true
    order:
      - formula.open
      - date
      - calendar-subject
      - projects
      - attendees
      - reviewed
      - archived
      - calendar_match
      - conflicts-with
    sort:
      - property: date
        direction: DESC
    rowHeight: medium
    columnSize:
      note.date: 150
      note.calendar-subject: 170
      note.projects: 150
      note.attendees: 140
      note.reviewed: 66
      note.archived: 80
      note.calendar_match: 128
      note.conflicts-with: 130
  - type: table
    name: All Meetings
    filters:
      and:
        - archived != true
    order:
      - formula.open
      - date
      - calendar-subject
      - projects
      - attendees
      - formula.review-state
      - type
      - formula.project-links
    sort:
      - property: date
        direction: DESC
    columnSize:
      formula.project-links: 112
