filters:
  and:
    - file.inFolder("20-meetings")
    - file.ext == "md"
formulas:
  open: link(file.path, "→")
  project-links: projects.map(link("30-projects/" + value + "/index.md", "↗"))
properties:
  formula.open:
    displayName: " "
  formula.project-links:
    displayName: "↗"
  note.date:
    displayName: Date
  note.type:
    displayName: Type
  note.calendar-subject:
    displayName: Subject
  note.calendar_match:
    displayName: Cal
  note.attendees:
    displayName: Attendees
  note.projects:
    displayName: Projects
  note.review_status:
    displayName: Review Status
  note.conflicts-with:
    displayName: "⚠ Duplicate of"
  note.reviewed:
    displayName: "✓ Reviewed"
  note.archived:
    displayName: "🗑 Archive"
  note.recording-duration:
    displayName: Duration
  note.source:
    displayName: Source
views:
  - type: table
    name: Triage
    filters:
      and:
        - review_status == "needs-review"
        - reviewed != true
        - archived != true
    order:
      - formula.open
      - date
      - calendar_match
      - calendar-subject
      - attendees
      - reviewed
      - projects
      - formula.project-links
      - archived
      - conflicts-with
    sort:
      - property: date
        direction: DESC
    rowHeight: medium
    columnSize:
      note.calendar_match: 54
      note.attendees: 251
      note.reviewed: 36
      formula.project-links: 32
  - type: table
    name: All Meetings
    order:
      - formula.open
      - date
      - calendar-subject
      - type
      - attendees
      - projects
      - formula.project-links
      - review_status
      - recording-duration
    sort:
      - property: date
        direction: DESC
    columnSize:
      formula.project-links: 32
