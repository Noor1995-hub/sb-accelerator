filters:
  and:
    - file.inFolder("20-meetings")
    - file.ext == "md"
formulas:
  open: link(file.path, "→")
  # Names, not slugs, in the read-only view (#240). To review keeps the
  # editable projects and attendees cells: that is where a wrong project
  # or person is fixed, by typing its slug.
  project-names: if(projects, projects.map(link("30-projects/" + value + "/index.md", if(file("30-projects/" + value + "/index.md"), file("30-projects/" + value + "/index.md").properties["project-name"], value))), "")
  attendee-names: if(attendees, attendees.map(if(file("50-people/" + value + ".md"), file("50-people/" + value + ".md").properties["person-name"], value)), "")
  kind: if(type == "status-update", "Status update", if(type == "1:1", "1:1", if(type, type.title(), "")))
  review-state: if(archived, "Dismissed", if(reviewed || review_status == "confirmed", "Kept", "To review"))
properties:
  formula.open:
    displayName: " "
  formula.project-names:
    displayName: Projects
  formula.attendee-names:
    displayName: Attendees
  formula.kind:
    displayName: Type
  formula.review-state:
    displayName: Status
  note.date:
    displayName: Date
  note.type:
    displayName: Type
  note.calendar-subject:
    displayName: Subject
  note.calendar_match:
    displayName: Calendar match
  note.attendees:
    displayName: Attendees
  note.projects:
    displayName: Projects
  note.review_status:
    displayName: Review Status
  note.conflicts-with:
    displayName: "⚠ Duplicate of"
  note.reviewed:
    displayName: Keep
  note.archived:
    displayName: Dismiss
  note.recording-duration:
    displayName: Duration
  note.source:
    displayName: Source
views:
  - type: table
    name: To review
    filters:
      and:
        - review_status == "needs-review"
        - reviewed != true
        - archived != true
    order:
      - formula.open
      - date
      - calendar-subject
      - projects
      - attendees
      - reviewed
      - archived
      - calendar_match
      - conflicts-with
    sort:
      - property: date
        direction: DESC
    rowHeight: tall
    columnSize:
      note.date: 150
      note.calendar-subject: 170
      note.projects: 150
      note.attendees: 140
      note.reviewed: 66
      note.archived: 80
      note.calendar_match: 128
      note.conflicts-with: 130
  - type: table
    name: All Meetings
    filters:
      and:
        - archived != true
    order:
      - formula.open
      - date
      - calendar-subject
      - formula.project-names
      - formula.attendee-names
      - formula.review-state
      - formula.kind
    sort:
      - property: date
        direction: DESC
    columnSize:
      formula.project-names: 170
      formula.attendee-names: 170
