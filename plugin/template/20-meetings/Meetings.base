filters:
  and:
    - file.inFolder("20-meetings")
    - file.ext == "md"
formulas:
  open: link(file.path, "→")
properties:
  formula.open:
    displayName: " "
  note.date:
    displayName: Date
  note.type:
    displayName: Type
  note.calendar-subject:
    displayName: Subject
  note.calendar_match:
    displayName: Cal
  note.attendees:
    displayName: Attendees
  note.projects:
    displayName: Projects
  note.review_status:
    displayName: Review Status
  note.conflicts-with:
    displayName: ⚠ Duplicate of
  note.reviewed:
    displayName: ✓ Reviewed
  note.archived:
    displayName: 🗑 Archive
  note.recording-duration:
    displayName: Duration
  note.source:
    displayName: Source
views:
  - type: table
    name: Triage
    filters:
      and:
        - review_status == "needs-review"
        - reviewed != true
        - archived != true
    order:
      - formula.open
      - date
      - calendar-subject
      - reviewed
      - conflicts-with
      - archived
      - calendar_match
      - projects
      - attendees
    sort:
      - property: date
        direction: DESC
    rowHeight: medium
  - type: table
    name: All Meetings
    order:
      - formula.open
      - date
      - calendar-subject
      - type
      - attendees
      - projects
      - review_status
      - recording-duration
    sort:
      - property: date
        direction: DESC
