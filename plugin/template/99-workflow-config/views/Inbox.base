filters:
  and:
    - file.inFolder("10-inbox")
    - file.name != "README"
    - file.ext != "base"
formulas:
  item: link(file.path, file.basename)
  kind: if(file.ext == "txt", "Text", if(file.ext == "md", "Note", file.ext.upper()))
properties:
  formula.item:
    displayName: Waiting to be filed
  formula.kind:
    displayName: Kind
  file.ctime:
    displayName: Added
views:
  - type: table
    name: Waiting
    order:
      - formula.item
      - formula.kind
      - file.ctime
    sort:
      - property: formula.item
        direction: DESC
      - property: file.ctime
        direction: DESC
    columnSize:
      formula.item: 460
